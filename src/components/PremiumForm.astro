---
/**
 * Eugenia-styled multi-step form. Posts to the school's HubSpot form through the public Forms API
 * (same portal and form id as the embed), so nothing changes in the CRM. One question per screen,
 * progress shown, inline validation, a confirmation that says what happens next. Without
 * JavaScript, all steps are shown and the visitor is given the public contact instead.
 */
import { FORMS, WHO } from "@/data/forms";
import { HUBSPOT, ROUTES, SITE } from "@/data/site";
import FocusField from "./FocusField.astro";
import ShareLink from "./ShareLink.astro";
import { ADMISSION_TIMELINE } from "@/data/focus-forms";
import { EVENTS_OPTIONS } from "@/data/forms";

interface Props {
  form: keyof typeof FORMS;
  focus?: boolean;
}
const { form, focus = false } = Astro.props;
const cfg = FORMS[form];
const total = cfg.steps.length;
---

<form
  class:list={["pf", focus && "pf--focus"]}
  data-premium-form
  data-focus-form={focus || undefined}
  data-form-kind={form}
  data-hs-portal={HUBSPOT.portalId}
  data-hs-form-id={cfg.formId}
  data-page-name={cfg.pageName}
  data-form-tone={form === "contact" ? "vous" : "tu"}
  data-done-title={cfg.done.title}
  data-done-title-parent={cfg.doneParent?.title}
  novalidate
  aria-labelledby={`pf-${form}-title-0`}
>
  <div class="pf__head">
    <div class="pf__mark" aria-hidden="true"></div>
    <p class="pf__progress" aria-live="polite" aria-atomic="true"><span class:list={[!focus && "sr-only"]}>Étape </span><span data-pf-step>1</span><span class="pf__progress-sep">{focus ? " sur " : "/"}</span>{total}</p>
    <div class="pf__bar" aria-hidden="true"><span data-pf-bar style={`width: ${100 / total}%`}></span></div>
  </div>

  {
    cfg.steps.map((step, i) => (
      <fieldset class="pf__step" data-pf-panel={i} hidden={i !== 0}>
        <legend class="pf__legend" id={`pf-${form}-title-${i}`} tabindex="-1" data-tone data-tu={step.title} data-vous={step.titleParent}>{step.title}</legend>
        {(step.kind === "choice" || (focus && step.kind === "select")) && (
          <div class:list={["pf__choices", step.kind === "choice" && step.cards && "pf__choices--cards", step.kind === "select" && "pf__choices--years"]} role="radiogroup" aria-labelledby={`pf-${form}-title-${i}`}>
            {(step.name === "all_type_multiple_checkboxes" ? cfg.who.map((w) => WHO[w]) : step.options).map((o) => (
              <label class="pf__choice">
                <input type="radio" name={step.name} value={o.value} required data-quick-choice={focus || undefined} />
                <span class="pf__choice-box">
                  {focus && <span class="pf__choice-icon" aria-hidden="true">{step.name === "all_type_multiple_checkboxes" ? (o.value === "All.Parent" ? "◎" : "↗") : "→"}</span>}
                  <span class="pf__choice-label">{focus && form === "candidature" && o.value === "All.Student" ? "Je suis futur·e étudiant·e" : focus && form === "candidature" && o.value === "All.Parent" ? "Je suis parent" : o.label}</span>
                  {o.hint && <span class="pf__choice-hint">{o.hint}</span>}
                </span>
              </label>
            ))}
          </div>
        )}
        {step.kind === "select" && !focus && (
          <div class="pf__field">
            <label class="pf__label" for={`pf-${form}-${step.name}`} data-tone data-tu={step.label} data-vous={step.labelParent}>{step.label}</label>
            <select class="pf__input" id={`pf-${form}-${step.name}`} name={step.name} required>
              <option value="">Choisir…</option>
              {step.options.map((o) => (
                <option value={o.value}>{o.label}</option>
              ))}
            </select>
          </div>
        )}
        {step.kind === "contact" && (
          <div class="pf__grid">
            {focus ? <>
              <FocusField form={form} name="firstname" label="Prénom" autocomplete="given-name" />
              <FocusField form={form} name="lastname" label="Nom" autocomplete="family-name" />
              <FocusField form={form} name="email" label="E-mail" type="email" autocomplete="email" />
              <FocusField form={form} name="phone" label="Téléphone" type="tel" autocomplete="tel" />
            </> : <><div class="pf__field">
              <label class="pf__label" for={`pf-${form}-firstname`}>Prénom</label>
              <input class="pf__input" id={`pf-${form}-firstname`} name="firstname" type="text" autocomplete="given-name" required />
            </div>
            <div class="pf__field">
              <label class="pf__label" for={`pf-${form}-lastname`}>Nom</label>
              <input class="pf__input" id={`pf-${form}-lastname`} name="lastname" type="text" autocomplete="family-name" required />
            </div>
            <div class="pf__field">
              <label class="pf__label" for={`pf-${form}-email`}>E-mail</label>
              <input class="pf__input" id={`pf-${form}-email`} name="email" type="email" autocomplete="email" inputmode="email" required />
            </div>
            <div class="pf__field">
              <label class="pf__label" for={`pf-${form}-phone`}>Téléphone</label>
              <input class="pf__input" id={`pf-${form}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="06 12 34 56 78" required />
            </div>
            </>}
            {step.message && (
              <div class="pf__field pf__field--full">
                <label class="pf__label" for={`pf-${form}-message`}>Votre question</label>
                <textarea class="pf__input" id={`pf-${form}-message`} name="message" rows="4" placeholder="Décrivez-nous votre besoin ou votre question" />
              </div>
            )}
          </div>
        )}
        {step.kind === "contact" && cfg.parentNote && (
          <p class="pf__note" data-pf-parent-note hidden>
            {cfg.parentNote} <a href={ROUTES.contact + "?pour=parent"} class="lnk">Poser une question</a>
          </p>
        )}
        <p class="pf__error" id={`pf-${form}-error-${i}`} data-pf-error role="alert" hidden></p>
        {focus && form === "candidature" && step.kind !== "contact" && <p class="pf__reassurance">{i === 0 ? "Hors Parcoursup et hors Mon Master" : i === 1 ? "Candidature gratuite pour les résidents de l'Union européenne" : "Rentrée en septembre"}</p>}
      </fieldset>
    ))
  }

  <div class="pf__nav">
    <button type="button" class="pf__back" data-pf-back hidden>{focus ? "← Étape précédente" : "Retour"}</button>
    <button type="button" class="btn pf__next" data-pf-next>Continuer</button>
    <button type="submit" class="btn pf__submit" data-pf-submit hidden><span class="pf__spinner" aria-hidden="true"></span>{cfg.submitLabel}</button>
  </div>
  <p class="pf__privacy">Les choix et les coordonnées sont obligatoires ; le message libre est facultatif. <a href={SITE.privacyUrl}>Confidentialité et utilisation des données</a>.</p>
  {focus && <p class="pf__draft-note" data-draft-note role="status"><span data-draft-status>Les réponses sont conservées dans cet onglet jusqu'à l'envoi, pendant 12 heures maximum.</span> <button type="button" data-clear-draft>Effacer mes réponses</button></p>}

  <div class="pf__done" data-pf-done hidden aria-live="polite">
    <div class="pf__done-mark" aria-hidden="true">{focus && <svg viewBox="0 0 32 32" width="32" height="32"><path d="m8 16 5 5 11-11" fill="none" stroke="currentColor" stroke-width="2" /></svg>}</div>
    <p class="pf__done-title" id={`pf-${form}-done-title`} data-pf-done-title tabindex="-1"></p>
    <ul class="pf__done-lines" data-pf-done-lines>
      {cfg.done.lines.map((l) => <li>{l}</li>)}
    </ul>
    {cfg.doneParent && (
      <ul class="pf__done-lines" data-pf-done-lines-parent hidden>
        {cfg.doneParent.lines.map((l) => <li>{l}</li>)}
      </ul>
    )}
    {focus && form === "candidature" && (
      <div class="pf__next-steps">
        <h2>Ce qui se passe ensuite</h2>
        <p class="pf__received">✓ Demande transmise</p>
        <ol>{ADMISSION_TIMELINE.map((title) => <li>{title}</li>)}</ol>
        <p class="pf__timeline-note">L'envoi de ce formulaire ne constitue pas encore un dossier complet.</p>
        <a class="btn-outline" href={ROUTES.evenements}>Venir à un événement</a>
        {Date.now() < Date.parse("2026-12-12T10:30:00+01:00") && <p class="pf__event-date">{EVENTS_OPTIONS[0].hint}</p>}
        <div data-student-share><ShareLink path="/parents" label="Partager avec mes parents" title="Découvrir Eugenia School" text="Les informations pour découvrir Eugenia School ensemble." event="share_to_parent" /></div>
      </div>
    )}
  </div>

  <noscript>
    <p class="pf__nojs">
      L'envoi du formulaire demande JavaScript. Écris-nous à <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
      ou appelle le <a href={SITE.contact.phoneHref}>{SITE.contact.phone}</a>.
    </p>
  </noscript>
</form>

<script src="@/scripts/premium-form.ts"></script>

<style>
  .pf {
    position: relative;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 36px 40px 32px;
    overflow: hidden;
  }
  .pf::before {
    /* Eugenia signature: the yellow line of the mockup, top left */
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 72px;
    height: 3px;
    background: var(--yellow);
  }
  .pf__head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
  }
  .pf__mark {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--red);
  }
  .pf__progress {
    margin: 0;
    font-size: 13px;
    color: var(--ink-65);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pf__progress-sep {
    margin-inline: 2px;
    color: var(--ink-45, var(--ink-65));
  }
  .pf__bar {
    flex: 1;
    height: 2px;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .pf__bar span {
    display: block;
    height: 100%;
    background: var(--red);
    transition: width 0.4s var(--ease-out);
  }
  .pf__step {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .pf__step[hidden] {
    display: none;
  }
  :global(html.js) .pf__step {
    transition:
      opacity var(--dur-ui) var(--ease-out),
      transform var(--dur-ui) var(--ease-out);
  }
  @starting-style {
    :global(html.js) .pf__step:not([hidden]) {
      opacity: 0;
      transform: translateX(8px);
    }
  }
  .pf__legend {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(24px, 2.2vw, 30px);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 22px;
    padding: 0;
    max-width: 16em;
  }
  .pf__choices {
    display: grid;
    gap: 10px;
  }
  .pf__choices--cards {
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
  }
  .pf__choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .pf__choice-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    cursor: pointer;
    min-height: 44px;
    transition:
      border-color var(--dur-ui) ease,
      background-color var(--dur-ui) ease;
  }
  .pf__choice-label {
    font-weight: 600;
    font-size: 16px;
  }
  .pf__choice-hint {
    font-size: 13px;
    color: var(--ink-65);
  }
  .pf__choice input:checked + .pf__choice-box {
    border-color: var(--plum);
    background: var(--mist);
    box-shadow: inset 0 0 0 1px var(--plum);
  }
  .pf__choice input:focus-visible + .pf__choice-box {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .pf__choice-box:hover {
      border-color: var(--plum);
    }
  }
  .pf__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 16px 20px;
  }
  .pf__field {
    display: grid;
    gap: 6px;
  }
  .pf__field--full {
    grid-column: 1 / -1;
  }
  .pf__label {
    font-size: 13px;
    color: var(--ink-65);
  }
  .pf__input {
    font: inherit;
    font-size: 16px;
    color: var(--plum);
    background: var(--white);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    padding: 13px 14px;
    min-height: 48px;
    width: 100%;
    transition: border-color var(--dur-ui) ease;
  }
  .pf__input:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 1px;
    border-color: var(--plum);
  }
  .pf__input[aria-invalid="true"] {
    border-color: var(--red);
  }
  textarea.pf__input {
    resize: vertical;
  }
  .pf__note {
    margin: 18px 0 0;
    padding: 12px 14px;
    background: var(--mist);
    border-radius: 12px;
    font-size: 14px;
    color: var(--ink-70);
    line-height: 1.5;
  }
  .pf__note[hidden],
  .pf__done-lines[hidden] {
    display: none;
  }
  .pf__error {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--red-dark);
  }
  .pf__error[hidden] {
    display: none;
  }
  .pf__nav {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
  }
  .pf__back {
    font: inherit;
    font-weight: 600;
    font-size: 15px;
    background: none;
    border: 0;
    padding: 10px 0;
    color: var(--plum);
    border-bottom: 1px solid rgba(31, 13, 25, 0.28);
    cursor: pointer;
    min-height: 44px;
  }
  .pf__back[hidden],
  .pf__next[hidden],
  .pf__submit[hidden],
  .pf__nav[hidden],
  .pf__head[hidden],
  .pf__privacy[hidden] {
    display: none;
  }
  .pf__submit[aria-busy="true"] {
    opacity: 0.7;
    pointer-events: none;
  }
  .pf__privacy {
    margin: 18px 0 0;
    font-size: 12px;
    color: var(--ink-65);
  }
  .pf__done {
    padding-block: 12px;
  }
  .pf__done[hidden] {
    display: none;
  }
  .pf__done-mark {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--red);
    position: relative;
    margin-bottom: 20px;
  }
  .pf__done-mark::after {
    content: "";
    position: absolute;
    left: 16px;
    top: 11px;
    width: 9px;
    height: 16px;
    border: solid var(--white);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .pf__done-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 2.6vw, 36px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 18px;
  }
  .pf__done-lines {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    font-size: 15px;
    color: var(--ink-70);
  }
  .pf__done-lines li::before {
    content: "—";
    color: var(--red);
    margin-right: 8px;
  }
  .pf__nojs {
    margin: 16px 0 0;
    font-size: 14px;
  }
  /* Without JavaScript: every step visible, no wizard controls */
  :global(html:not(.js)) .pf__step[hidden] {
    display: block;
    margin-top: 28px;
  }
  :global(html:not(.js)) .pf__nav,
  :global(html:not(.js)) .pf__head {
    display: none;
  }
  @media (max-width: 767px) {
    .pf {
      padding: 28px var(--gutter) 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pf__bar span,
    :global(html.js) .pf__step {
      transition: none;
    }
  }
</style>
