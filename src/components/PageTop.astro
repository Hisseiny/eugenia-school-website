---
/** Top of every inner page: title left, lead right, then a full-width photo at its ratio. */
import Pic from "@/components/Pic.astro";
import { img } from "@/data/images";

interface Props {
  title: string;
  id?: string;
  lead?: string;
  image?: string;
  alt?: string;
  eyebrow?: string;
  dataAnswer?: boolean;
  nativeImage?: boolean;
  ratio?: string;
  position?: string;
}
const { title, id, lead, image, alt = "", eyebrow, dataAnswer = false, nativeImage = false, ratio, position } = Astro.props;
---

<section id={id} class:list={["container", "pagetop", !lead && "pagetop--single"]}>
  <div class="pagetop__title-wrap">
    {eyebrow && <p class="eyebrow pagetop__eyebrow">{eyebrow}</p>}
    <h1 class="r1 display">{title}</h1>
  </div>
  {lead && <p class="r2 lead pagetop__lead" data-answer={dataAnswer ? "" : undefined}>{lead}</p>}
</section>
{image && (
  <figure class="container r3">
    <Pic src={img(image)} alt={alt} ratio={nativeImage ? undefined : ratio ?? "16 / 9"} position={position} priority sizes="(min-width: 1440px) 1376px, 100vw" />
  </figure>
)}

<style>
  .pagetop {
    padding-top: 104px;
    padding-bottom: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 32px 80px;
    align-items: end;
  }
  .pagetop__title-wrap,
  .pagetop__lead {
    min-width: 0;
    max-width: 100%;
  }
  .pagetop__lead {
    margin-bottom: 10px;
    max-width: 26em;
  }
  .pagetop__eyebrow {
    margin-bottom: 18px;
  }
  /* The title column takes the width of the word; the lead gets the rest. */
  @media (min-width: 1024px) {
    .pagetop {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .pagetop--single {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 1023px) {
    .pagetop {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
  @media (max-width: 767px) {
    .pagetop {
      padding-top: 56px;
      padding-bottom: 36px;
      gap: 20px;
    }
    .pagetop .display {
      font-size: clamp(36px, 11vw, 96px);
    }
  }
</style>
