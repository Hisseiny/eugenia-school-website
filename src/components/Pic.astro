---
/**
 * A photo in a frame that keeps the photo's own ratio. Never zooms.
 * `ratio` is a CSS aspect-ratio value ("16 / 9"); omit it to use the image's natural ratio.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string;
  position?: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  decorative?: boolean;
  class?: string;
  style?: string;
}

const {
  src,
  alt,
  ratio,
  position,
  sizes = "(min-width: 1440px) 1376px, 100vw",
  widths = [480, 768, 1024, 1440, 1800],
  priority = false,
  decorative = false,
  class: className = "",
  style = "",
} = Astro.props;

const naturalRatio = `${src.width} / ${src.height}`;
const vars = [
  `--ratio: ${ratio ?? naturalRatio}`,
  position ? `--pos: ${position}` : "",
  style,
]
  .filter(Boolean)
  .join("; ");
const usableWidths = widths.filter((w) => w <= src.width);
if (usableWidths.length === 0 || usableWidths[usableWidths.length - 1] !== src.width) {
  usableWidths.push(src.width);
}
---

<div class:list={["pic", className]} style={vars}>
  <Image
    src={src}
    alt={decorative ? "" : alt}
    aria-hidden={decorative ? "true" : undefined}
    widths={usableWidths}
    sizes={sizes}
    format="webp"
    quality={82}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
    decoding={priority ? "sync" : "async"}
  />
</div>
