---
import Logo from "./Logo.astro";
import type { LogoSpec } from "@/data/logos";
interface Props { logos: LogoSpec[]; id: string; }
const { logos, id } = Astro.props;
---
<div class="logo-flow" data-logo-flow>
  <div id={id}>
    <ul class="logo-flow__static" aria-label="Entreprises qui recrutent nos étudiants">
      {logos.map((logo) => <li><Logo {...logo} /></li>)}
    </ul>
    <div class="logo-flow__motion" aria-hidden="true">
      {logos.map((logo, index) => (
        <div class="logo-flow__cell" style={`--offset:-${620 + (index % 6) * 90 + Math.floor(index / 6) * 45}ms`}>
          <div class="logo-flow__layer"><Logo {...logo} decorative /></div>
          <div class="logo-flow__layer logo-flow__layer--next"><Logo {...logos[(index + 6) % logos.length]} decorative /></div>
        </div>
      ))}
    </div>
  </div>
  <button class="logo-flow__pause" type="button" aria-pressed="false" aria-controls={id} disabled>Mettre en pause</button>
</div>
<script>
  import "../scripts/scrolling-logo-grid";
</script>
<style>
  .logo-flow { margin-top: 48px; }
  .logo-flow__static { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border-top: 1px solid #e8e5e7; border-left: 1px solid #e8e5e7; }
  .logo-flow__static li, .logo-flow__cell { height: 110px; border-bottom: 1px solid #e8e5e7; border-right: 1px solid #e8e5e7; }
  .logo-flow__static li, .logo-flow__layer { display: flex; align-items: center; justify-content: center; padding: 20px; }
  .logo-flow__cell { position: relative; overflow: hidden; }
  .logo-flow__layer { position: absolute; inset: 0; }
  .logo-flow__static :global(img), .logo-flow__cell :global(img) { object-fit: contain; max-width: 100%; }
  .logo-flow__motion { display: none; }
  .logo-flow__pause { display: block; visibility: hidden; margin: 16px 0 0 auto; min-height: 44px; padding: 8px 14px; font: inherit; font-size: 14px; color: inherit; border: 1px solid currentColor; border-radius: 4px; background: transparent; cursor: pointer; }
  .is-enhanced .logo-flow__pause { visibility: visible; }
  .logo-flow__pause:focus-visible { outline: 2px solid #75192b; outline-offset: 4px; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .logo-flow__static { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
    :global(html.js) .logo-flow__motion { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); border-top: 1px solid #e8e5e7; border-left: 1px solid #e8e5e7; }
    .logo-flow__layer { animation: logo-cell-replace 5200ms var(--ease-out-expo) infinite; animation-delay: var(--offset); animation-play-state: paused; }
    .logo-flow__layer--next { animation-delay: calc(var(--offset) - 2600ms); }
    .is-running .logo-flow__layer { animation-play-state: running; }
    @keyframes logo-cell-replace {
      0% { transform: translateY(100%); opacity: 0; }
      11.923%, 50% { transform: translateY(0); opacity: 1; }
      52.885%, 99.999% { transform: translateY(0); opacity: 0; }
      100% { transform: translateY(100%); opacity: 0; }
    }
  }
  @media (max-width: 900px) {
    .logo-flow__static { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    :global(html.js) .logo-flow__motion { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .logo-flow__static { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    :global(html.js) .logo-flow__motion { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
