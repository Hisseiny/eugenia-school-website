---
import type { CurriculumProgram } from "@/data/curriculum";

interface Props {
  curriculum: CurriculumProgram;
}

const { curriculum } = Astro.props;
---

<section class="container curriculum" aria-label="Programme détaillé">
  {
    curriculum.years.map((year) => (
      <section class="curriculum__year" aria-labelledby={`year-${year.code}`}>
        <h3 class="h3-sm curriculum__year-title" id={`year-${year.code}`}>{year.title ?? year.code}</h3>
        {year.intro && <p class="curriculum__year-intro">{year.intro}</p>}
        {
          year.semesters.map((semester) => (
            <section class="curriculum__semester" aria-labelledby={`semester-${semester.code}-${semester.number}`}>
              <h4 id={`semester-${semester.code}-${semester.number}`}>
                {semester.code} · Semestre {semester.number} — {semester.hours} h · {semester.ects} ECTS
              </h4>
              <div class="curriculum__module-head" aria-hidden="true">
                <span>Module</span><span>Volume horaire</span><span>ECTS</span>
              </div>
              <div class="curriculum__modules">
                {
                  semester.modules.map((module) => (
                    <details class="curriculum__module">
                      <summary>
                        <span class="curriculum__module-name">{module.name} — {module.description}</span>
                        <span class="sr-only" aria-hidden="true"> — </span>
                        <span class="curriculum__module-hours">{module.hours} h</span>
                        <span class="sr-only" aria-hidden="true"> · </span>
                        <span class="curriculum__module-ects">{module.ects} ECTS</span>
                      </summary>
                      <div class="curriculum__courses">
                        <div class="curriculum__course-head">
                          <span>Code</span><span>Cours</span><span>Volume horaire</span><span>ECTS</span>
                        </div>
                        <ul>
                          {
                            module.courses.map((course) => (
                              <li>
                                <span class="curriculum__course-code">{course.code}</span>
                                <span class="curriculum__course-name">{course.name}</span>
                                <span class="curriculum__course-hours">{course.hours} h</span>
                                <span class="curriculum__course-ects">{course.ects} ECTS</span>
                              </li>
                            ))
                          }
                        </ul>
                      </div>
                    </details>
                  ))
                }
              </div>
            </section>
          ))
        }
      </section>
    ))
  }
</section>

<style>
  .curriculum {
    padding-block: 24px var(--section-y-sm);
  }
  .curriculum__year + .curriculum__year {
    margin-top: 72px;
  }
  .curriculum__year-title {
    margin-bottom: 28px;
  }
  .curriculum__year-intro {
    max-width: 780px;
    margin: -12px 0 28px;
    color: var(--ink-65);
  }
  .curriculum__semester + .curriculum__semester {
    margin-top: 40px;
  }
  .curriculum__semester h4 {
    margin: 0;
    padding-block: 18px;
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .curriculum__modules { border-top: 1px solid var(--line); }
  .curriculum__module-head,
  .curriculum__module summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 0.22fr) minmax(70px, 0.14fr);
    gap: 12px 24px;
    align-items: baseline;
  }
  .curriculum__module-head {
    padding: 12px 36px 12px 0;
    border-top: 1px solid var(--line);
    color: var(--ink-60);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .curriculum__module {
    border-bottom: 1px solid var(--line);
  }
  .curriculum__module summary {
    padding: 18px 36px 18px 0;
    position: relative;
    cursor: pointer;
    list-style: none;
  }
  .curriculum__module summary::-webkit-details-marker {
    display: none;
  }
  .curriculum__module summary::after {
    content: "+";
    position: absolute;
    right: 4px;
    top: 18px;
    color: var(--ink-60);
    transition: transform 0.18s var(--ease-out);
  }
  .curriculum__module[open] summary::after {
    transform: rotate(45deg);
  }
  .curriculum__module-name {
    font-weight: 600;
  }
  .curriculum__module-description {
    margin-bottom: 20px;
  }
  .curriculum__module-hours,
  .curriculum__module-ects {
    color: var(--ink-65);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .curriculum__module-hours,
  .curriculum__module-ects,
  .curriculum__course-meta {
    font-variant-numeric: tabular-nums;
  }
  .curriculum__courses {
    padding: 0 0 18px;
  }
  .curriculum__course-head,
  .curriculum__courses ul {
    display: grid;
    gap: 10px;
  }
  .curriculum__course-head,
  .curriculum__courses li {
    display: grid;
    grid-template-columns: minmax(84px, 0.35fr) minmax(0, 1.45fr) minmax(95px, 0.5fr) minmax(60px, 0.3fr);
    gap: 12px 20px;
    align-items: baseline;
    font-size: 15px;
  }
  .curriculum__course-head {
    margin-bottom: 10px;
    color: var(--ink-60);
    font-size: 12px;
  }
  .curriculum__course-code,
  .curriculum__course-hours,
  .curriculum__course-ects {
    color: var(--ink-60);
    font-size: 13px;
  }
  @media (max-width: 767px) {
    .curriculum__module-head,
    .curriculum__module summary {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 8px;
    }
    .curriculum__courses li {
      grid-template-columns: 68px minmax(0, 1fr);
      gap: 4px 12px;
    }
    .curriculum__course-head {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 12px;
    }
    .curriculum__courses li .curriculum__course-hours,
    .curriculum__courses li .curriculum__course-ects {
      grid-column: 2;
    }
    .curriculum__course-name {
      grid-column: 2;
    }
    .curriculum__course-meta {
      grid-column: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .curriculum__module summary::after {
      transition: none;
    }
  }
</style>
