---
/** A partner or recruiter logo at a fixed display height; width follows the file's ratio. */
import { Image } from "astro:assets";
import { img, svg } from "@/data/images";

interface Props {
  name: string;
  alt: string;
  height: number;
  gray?: boolean;
  decorative?: boolean;
  class?: string;
}
const { name, alt, height, gray = false, decorative = false, class: className = "" } = Astro.props;
const vector = svg(name);
const src = vector ? undefined : img(name);
const width = src ? Math.round((src.width / src.height) * height) : undefined;
---

<span class:list={[gray && "gray", className]}>
  {
    vector ? (
      <img src={vector} alt={decorative ? "" : alt} aria-hidden={decorative ? "true" : undefined} loading="lazy" style={`height: ${height}px; max-width: 100%; width: auto`} />
    ) : (
      <Image
        src={src!}
        alt={decorative ? "" : alt}
        aria-hidden={decorative ? "true" : undefined}
        width={width! * 2}
        height={height * 2}
        format="webp"
        loading="lazy"
        style={`width: ${width}px; max-width: 100%; height: auto`}
      />
    )
  }
</span>
