---
import { Image } from "astro:assets";
import { img } from "@/data/images";
import { NAV, ROUTES } from "@/data/site";

interface Props {
  /** Plum header on the home page, white everywhere else. */
  tone?: "plum" | "white";
  current?: string;
}
const { tone = "white", current } = Astro.props;
const logo = tone === "plum" ? img("lg_eugenia_white") : img("lg_eugenia");
---

<header class:list={["site-header", tone === "plum" && "site-header--plum"]} data-header>
  <div class="container site-header__row">
    <a href={ROUTES.home} aria-label="Eugenia School, accueil" class="site-header__logo">
      <Image src={logo} alt="Eugenia School" width={300} height={52} format="webp" loading="eager" />
    </a>
    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" class="ico-open"></path>
        <path d="M6 6l12 12M18 6L6 18" class="ico-close"></path>
      </svg>
    </button>
    <nav id="site-nav" class="site-header__nav" aria-label="Navigation principale">
      <ul class="site-header__links">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={ROUTES.evenements} class="site-header__event">Portes ouvertes</a>
    </nav>
    <a href={ROUTES.admissions} class="btn site-header__cta">Candidater</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid rgba(31, 13, 25, 0.07);
    color: var(--plum);
    transition:
      background-color var(--dur-ui) ease,
      border-color var(--dur-ui) ease;
  }
  .site-header--plum {
    background: var(--plum);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    color: var(--white);
  }
  .site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.82);
    border-bottom-color: rgba(31, 13, 25, 0.12);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }
  .site-header--plum.is-scrolled {
    background: rgba(31, 13, 25, 0.84);
    border-bottom-color: rgba(255, 255, 255, 0.14);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: 56px;
    padding-block: 20px;
  }
  /* The open mobile menu must stay readable: no translucency behind it */
  .site-header.is-scrolled:has(.site-header__nav.is-open) {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .site-header--plum.is-scrolled:has(.site-header__nav.is-open) {
    background: var(--plum);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
  .site-header__logo img {
    height: 26px;
    width: auto;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 32px;
    flex: 1;
  }
  .site-header__links {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    flex: 1;
    font-size: 15px;
    font-weight: 500;
  }
  .site-header__links a,
  .site-header__event {
    color: inherit;
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease-out;
  }
  .site-header__links a:hover,
  .site-header__links a[aria-current="page"] {
    border-bottom-color: currentColor;
  }
  .site-header__event {
    font-size: 15px;
    font-weight: 500;
    margin-left: auto;
  }
  .site-header__cta {
    margin-left: -34px;
  }
  .site-header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: transparent;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: inherit;
  }
  .ico-close {
    display: none;
  }
  .site-header__toggle[aria-expanded="true"] .ico-open {
    display: none;
  }
  .site-header__toggle[aria-expanded="true"] .ico-close {
    display: block;
  }

  @media (min-width: 1024px) and (max-width: 1199px) {
    .site-header__row {
      gap: 28px;
    }
    .site-header__nav,
    .site-header__links {
      gap: 20px;
    }
    .site-header__links,
    .site-header__event {
      font-size: 14px;
    }
    .site-header__cta {
      margin-left: -10px;
      padding-inline: 16px;
    }
  }

  @media (max-width: 1023px) {
    .site-header__row {
      flex-wrap: wrap;
      gap: 16px 12px;
      padding-block: 14px;
    }
    .site-header__logo img {
      height: 22px;
    }
    .site-header__cta {
      padding-inline: 16px;
      font-size: 15px;
    }
    .site-header__toggle {
      display: inline-flex;
      order: 3;
      margin-left: 0;
    }
    .site-header__cta {
      order: 2;
      margin-left: auto;
    }
    .site-header__nav {
      order: 4;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      padding-block: 8px 12px;
    }
    .site-header__links {
      flex-direction: column;
      gap: 4px;
      font-size: 18px;
    }
    .site-header__links a {
      display: block;
      padding: 10px 0;
      border-bottom-color: var(--line-soft);
    }
    .site-header--plum .site-header__links a {
      border-bottom-color: rgba(255, 255, 255, 0.12);
    }
    .site-header__event {
      margin-left: 0;
      font-size: 18px;
      padding: 10px 0;
    }
    /* With JS on, the menu is closed until opened. Without JS it stays readable. */
    :global(html.js) .site-header__nav:not(.is-open) {
      display: none;
      opacity: 0;
      transform: translateY(-4px); /* exit subtler than enter */
    }
    /*
     * Motion: the menu is a panel that appears from the header, so it slides 6 px down with a
     * fade (200 ms, ease-out; Kowalski's dropdown budget is 150-250 ms). CSS transition +
     * @starting-style keeps it interruptible; browsers without support just show it.
     */
    :global(html.js) .site-header__nav {
      transition:
        opacity var(--dur-ui) var(--ease-out),
        transform var(--dur-ui) var(--ease-out),
        display var(--dur-ui) allow-discrete;
    }
    @starting-style {
      :global(html.js) .site-header__nav.is-open {
        opacity: 0;
        transform: translateY(-6px);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      :global(html.js) .site-header__nav {
        transition: opacity var(--dur-ui) ease;
      }
      @starting-style {
        :global(html.js) .site-header__nav.is-open {
          transform: none;
        }
      }
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    let ticking = false;
    const update = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 12);
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const nav = document.getElementById("site-nav");
  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      nav.classList.toggle("is-open", !open);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("is-open")) {
        nav.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.focus();
      }
    });
  }
</script>
