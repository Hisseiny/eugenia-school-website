---
/**
 * Embeds one of the school's existing HubSpot forms (same portal, region and form ids as the live site).
 * Without JavaScript the visitor gets a fallback link instead of an empty box.
 */
import { HUBSPOT, SITE } from "@/data/site";

interface Props {
  form?: keyof typeof HUBSPOT.forms;
  formId?: string;
  portalId?: string;
  region?: string;
}
const { form, formId: publicFormId, portalId = HUBSPOT.portalId, region = HUBSPOT.region } = Astro.props;
const formId = publicFormId ?? (form ? HUBSPOT.forms[form] : undefined);
if (!formId) throw new Error("HubspotForm requires a form key or public form id.");
const id = `hs-form-${form ?? formId}`;
const { email, phone, phoneHref } = SITE.contact;
---

<div
  id={id}
  class="hs-form"
  data-hs-portal={portalId}
  data-hs-region={region}
  data-hs-form-id={formId}
>
  <noscript>
    <p>
      Merci d'activer JavaScript pour afficher ce formulaire, ou écris-nous à
      <a href={`mailto:${email}`}>{email}</a> (<a href={phoneHref}>{phone}</a>).
    </p>
  </noscript>
  <template data-hs-fallback>
    <p>
      Le formulaire n'a pas pu se charger (un bloqueur de contenu, peut-être). Réessaie sans bloqueur, ou
      écris-nous à <a href={`mailto:${email}`}>{email}</a> (<a href={phoneHref}>{phone}</a>).
    </p>
  </template>
</div>

<script>
  type Hbspt = { forms: { create: (opts: Record<string, string>) => void } };
  declare global {
    interface Window {
      hbspt?: Hbspt;
    }
  }

  const SCRIPT_ID = "hs-embed-v2";

  const TIMEOUT_MS = 8000;

  /** Resolves when HubSpot's embed script is usable; rejects if it is blocked, fails or takes too long. */
  function loadEmbed(region: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (window.hbspt) return resolve();
      let s = document.getElementById(SCRIPT_ID) as HTMLScriptElement | null;
      if (!s) {
        s = document.createElement("script");
        s.id = SCRIPT_ID;
        s.src = `https://js-${region}.hsforms.net/forms/embed/v2.js`;
        s.async = true;
        document.head.appendChild(s);
      }
      const timer = window.setTimeout(() => reject(new Error("hubspot embed timeout")), TIMEOUT_MS);
      s.addEventListener("load", () => { window.clearTimeout(timer); resolve(); }, { once: true });
      s.addEventListener("error", () => { window.clearTimeout(timer); reject(new Error("hubspot embed blocked")); }, { once: true });
    });
  }

  function showFallback(el: HTMLElement) {
    const tpl = el.querySelector<HTMLTemplateElement>("template[data-hs-fallback]");
    if (tpl) el.replaceChildren(tpl.content.cloneNode(true));
  }

  document.querySelectorAll<HTMLElement>(".hs-form[data-hs-form-id]").forEach(async (el) => {
    const { hsPortal, hsRegion, hsFormId } = el.dataset;
    if (!hsPortal || !hsRegion || !hsFormId) return;
    try {
      await loadEmbed(hsRegion);
      if (!window.hbspt) throw new Error("hubspot embed unavailable");
      window.hbspt.forms.create({ region: hsRegion, portalId: hsPortal, formId: hsFormId, target: `#${el.id}` });
    } catch {
      showFallback(el);
    }
  });
</script>

<style>
  .hs-form {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px;
  }
  .hs-form :global(form.hs-form) {
    width: 100%;
    max-width: 100%;
    margin: 0;
    font-family: var(--font-text);
  }
  .hs-form :global(fieldset) {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .hs-form :global(fieldset.form-columns-2) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 20px;
    width: 100%;
    margin-bottom: 16px;
  }
  .hs-form :global(fieldset.form-columns-2 > .hs-form-field) {
    width: 100% !important;
    min-width: 0;
    margin: 0;
    float: none;
  }
  .hs-form :global(.hs-form-field) {
    min-width: 0;
    margin-bottom: 16px;
  }
  .hs-form :global(.input) {
    width: 100%;
    margin-right: 0;
  }
  .hs-form :global(label),
  .hs-form :global(legend) {
    display: block;
    margin: 0 0 6px;
    color: var(--ink-65);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
  }
  .hs-form :global(input.hs-input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"])),
  .hs-form :global(select.hs-input),
  .hs-form :global(textarea.hs-input) {
    display: block;
    box-sizing: border-box;
    width: 100% !important;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--plum);
    background: var(--white);
    font-family: var(--font-text);
    font-size: 16px;
    line-height: 1.4;
    transition: border-color var(--dur-ui) ease;
  }
  .hs-form :global(.hs-input::placeholder) {
    color: var(--ink-55);
    opacity: 1;
  }
  .hs-form :global(.hs-input:focus-visible) {
    outline: 2px solid var(--red);
    outline-offset: 1px;
    border-color: var(--plum);
  }
  .hs-form :global(.hs-input[aria-invalid="true"]) {
    border-color: var(--red);
  }
  .hs-form :global(textarea.hs-input) {
    resize: vertical;
  }
  .hs-form :global(.hs-error-msgs) {
    margin: 14px 0 0;
    padding: 0;
    color: var(--red-dark);
    font-family: var(--font-text);
    font-size: 14px;
    line-height: 1.5;
    list-style: none;
  }
  .hs-form :global(.hs-error-msgs li) {
    list-style: none;
  }
  .hs-form :global(.hs-error-msg) {
    color: var(--red-dark);
    font-family: var(--font-text);
    font-size: 14px;
    line-height: 1.5;
  }
  .hs-form :global(.hs-submit) {
    margin-top: 8px;
  }
  .hs-form :global(.hs-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: auto;
    max-width: 100%;
    min-height: 44px;
    padding: 11px 22px;
    border: 0;
    border-radius: var(--radius-pill);
    color: var(--white);
    background: var(--red);
    font-family: var(--font-text);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition:
      transform 0.16s var(--ease-out),
      background-color 0.2s ease-out;
  }
  .hs-form :global(.hs-button:hover) {
    color: var(--white);
    background: var(--red-hover);
  }
  .hs-form :global(.hs-button:active) {
    transform: scale(0.97);
  }
  .hs-form :global(.hs-button:focus-visible) {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  @media (max-width: 767px) {
    .hs-form {
      padding: 24px;
    }
    .hs-form :global(fieldset.form-columns-2) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
