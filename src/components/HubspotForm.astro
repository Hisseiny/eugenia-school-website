---
/**
 * Embeds one of the school's existing HubSpot forms (same portal, region and form ids as the live site).
 * Without JavaScript the visitor gets a fallback link instead of an empty box.
 */
import { HUBSPOT, SITE } from "@/data/site";

interface Props {
  form?: keyof typeof HUBSPOT.forms;
  formId?: string;
  portalId?: string;
  region?: string;
  minHeight?: number;
}
const { form, formId: publicFormId, portalId = HUBSPOT.portalId, region = HUBSPOT.region, minHeight = 420 } = Astro.props;
const formId = publicFormId ?? (form ? HUBSPOT.forms[form] : undefined);
if (!formId) throw new Error("HubspotForm requires a form key or public form id.");
const id = `hs-form-${form ?? formId}`;
const { email, phone, phoneHref } = SITE.contact;
---

<div
  id={id}
  class="hs-form"
  data-hs-portal={portalId}
  data-hs-region={region}
  data-hs-form-id={formId}
  style={`min-height: ${minHeight}px`}
>
  <noscript>
    <p>
      Merci d'activer JavaScript pour afficher ce formulaire, ou écris-nous à
      <a href={`mailto:${email}`}>{email}</a> (<a href={phoneHref}>{phone}</a>).
    </p>
  </noscript>
  <template data-hs-fallback>
    <p>
      Le formulaire n'a pas pu se charger (un bloqueur de contenu, peut-être). Réessaie sans bloqueur, ou
      écris-nous à <a href={`mailto:${email}`}>{email}</a> (<a href={phoneHref}>{phone}</a>).
    </p>
  </template>
</div>

<script>
  type Hbspt = { forms: { create: (opts: Record<string, string>) => void } };
  declare global {
    interface Window {
      hbspt?: Hbspt;
    }
  }

  const SCRIPT_ID = "hs-embed-v2";

  const TIMEOUT_MS = 8000;

  /** Resolves when HubSpot's embed script is usable; rejects if it is blocked, fails or takes too long. */
  function loadEmbed(region: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (window.hbspt) return resolve();
      let s = document.getElementById(SCRIPT_ID) as HTMLScriptElement | null;
      if (!s) {
        s = document.createElement("script");
        s.id = SCRIPT_ID;
        s.src = `https://js-${region}.hsforms.net/forms/embed/v2.js`;
        s.async = true;
        document.head.appendChild(s);
      }
      const timer = window.setTimeout(() => reject(new Error("hubspot embed timeout")), TIMEOUT_MS);
      s.addEventListener("load", () => { window.clearTimeout(timer); resolve(); }, { once: true });
      s.addEventListener("error", () => { window.clearTimeout(timer); reject(new Error("hubspot embed blocked")); }, { once: true });
    });
  }

  function showFallback(el: HTMLElement) {
    const tpl = el.querySelector<HTMLTemplateElement>("template[data-hs-fallback]");
    if (tpl) el.replaceChildren(tpl.content.cloneNode(true));
  }

  document.querySelectorAll<HTMLElement>(".hs-form[data-hs-form-id]").forEach(async (el) => {
    const { hsPortal, hsRegion, hsFormId } = el.dataset;
    if (!hsPortal || !hsRegion || !hsFormId) return;
    try {
      await loadEmbed(hsRegion);
      if (!window.hbspt) throw new Error("hubspot embed unavailable");
      window.hbspt.forms.create({ region: hsRegion, portalId: hsPortal, formId: hsFormId, target: `#${el.id}` });
    } catch {
      showFallback(el);
    }
  });
</script>

<style>
  .hs-form {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px;
  }
</style>
