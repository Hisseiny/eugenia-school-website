---
import { Image } from "astro:assets";
import { img } from "@/data/images";
import Logo from "@/components/Logo.astro";
import { ROUTES, SITE } from "@/data/site";

const columns = [
  {
    title: "Studienprogramme",
    links: [
      { href: ROUTES.programmeBachelor, label: "Bachelor" },
      { href: ROUTES.programmeMsc, label: "MSc" },
      { href: ROUTES.certificationNoCode, label: "Entwickler für No-Code-Lösungen" },
      { href: ROUTES.certificationArchitecteIA, label: "KI-Architekt" },
      { href: ROUTES.carrieres, label: "Berufliche Laufbahnen und Alumni" },
    ],
  },
  {
    title: "Die Hochschule",
    links: [
      { href: ROUTES.notreAdn, label: "Unsere DNA" },
      { href: ROUTES.campusParis, label: "Der Campus" },
      { href: ROUTES.approchePedagogique, label: "Die Lehrenden" },
      { href: ROUTES.vieEtudiante, label: "Studierendenleben" },
      { href: ROUTES.entrepreneuriat, label: "Unternehmertum" },
      { href: ROUTES.methodeEugenia, label: "Die Eugenia-Methode" },
      { href: ROUTES.portfolio, label: "Studierendenportfolios" },
    ],
  },
  {
    title: "Studienzulassung",
    links: [
      { href: ROUTES.admissions, label: "Jetzt bewerben" },
      { href: ROUTES.processusAdmission, label: "Zulassungsverfahren" },
      { href: ROUTES.alternance, label: "Duales Studium" },
      { href: ROUTES.financement, label: "Studienfinanzierung" },
      { href: ROUTES.faq, label: "Häufig gestellte Fragen" },
      { href: ROUTES.parents, label: "Eltern" },
      { href: ROUTES.contact, label: "Kontakt aufnehmen" },
      { href: ROUTES.entreprises, label: "Unternehmen" },
      { href: ROUTES.entreprisesPartenaires, label: "Partnerunternehmen" },
      { href: ROUTES.recruterNosEtudiants, label: "Unsere Studierenden einstellen" },
      { href: ROUTES.projetsEntreprises, label: "Projekte mit Unternehmen" },
      { href: ROUTES.projetMistral, label: "Hackathon mit Mistral AI, Make und Malt" },
      { href: ROUTES.projetOpenAI, label: "Hackathon mit Mirakl und OpenAI" },
      { href: ROUTES.projetDust, label: "Hackathon Dust" },
    ],
  },
];
---

<footer class="footer dark">
  <div class="container footer__grid">
    <div>
      <Image src={img("lg_eugenia_white")} alt="Eugenia School" width={300} height={52} format="webp" loading="lazy" class="footer__logo" />
      <p class="footer__address">{SITE.address.street}<br />{SITE.address.postalCode} {SITE.address.city}</p>
      <div class="footer__badges">
        <Logo name="lg_fc" alt="France Compétences" height={26} class="logo-pad" />
        <Logo name="lg_qualiopi" alt="Qualiopi" height={26} class="logo-pad" />
      </div>
    </div>
    {
      columns.map((col) => (
        <nav class="footer__col" aria-label={col.title}>
          <span class="footer__title">{col.title}</span>
          {col.links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </nav>
      ))
    }
  </div>
  <div class="container footer__bottom">
    <span>© {new Date().getFullYear()} Eugenia School</span>
    <span>
      <a href={SITE.legalUrl} rel="noopener">Impressum</a> und{" "}
      <a href={SITE.privacyUrl} rel="noopener">Datenschutz</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    padding: 96px 0 48px;
    font-size: 15px;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
    gap: 48px;
  }
  .footer__logo {
    height: 24px;
    width: auto;
    margin-bottom: 24px;
  }
  .footer__address {
    color: var(--paper-70);
    line-height: 1.6;
  }
  .footer__badges {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    align-items: center;
  }
  .footer__badges :global(.logo-pad) {
    padding: 6px 8px;
  }
  .footer__col {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .footer__title {
    color: var(--paper-55);
    font-size: 14px;
    margin-bottom: 4px;
  }
  .footer__col a {
    text-decoration: none;
    width: fit-content;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease-out;
  }
  .footer__col a:hover,
  .footer__bottom a:hover {
    border-bottom-color: var(--white);
  }
  .footer__bottom {
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--line-w);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--paper-55);
  }
  .footer__bottom a {
    color: var(--paper-55);
    text-decoration: none;
    border-bottom: 1px solid var(--line-w-link);
  }
  @media (max-width: 767px) {
    .footer {
      padding: 72px 0 40px;
    }
  }
</style>
