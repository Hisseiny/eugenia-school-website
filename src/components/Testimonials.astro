---
import { Image } from "astro:assets";
import Logo from "@/components/Logo.astro";
import { img } from "@/data/images";
import { STATS, TESTIMONIALS } from "@/data/home";
import { ROUTES } from "@/data/site";
---

<section class="section testi" aria-labelledby="testi-title">
  <div class="container">
    <div class="section-head testi__head">
      <h2 id="testi-title" class="h2 testi__title">De là où ils étaient à là où ils sont.</h2>
      <a href={ROUTES.carrieres} class="lnk">Toutes les trajectoires</a>
    </div>
    <div class="testi__grid" data-carousel>
      <dl class="testi__stats">
        {
          STATS.map((s) => (
            <div class="testi__stat">
              <dt class="figure-num">{s.value}</dt>
              <dd class="testi__stat-label">{s.label}</dd>
            </div>
          ))
        }
        <div class="testi__stat-end"></div>
      </dl>
      <div class="testi__slides" aria-live="polite">
        {
          TESTIMONIALS.map((t, i) => (
            <article class="testi__slide" data-slide hidden={i !== 0} aria-hidden={i !== 0 ? "true" : "false"} id={`temoignage-${t.id}`}>
              <div class="pic testi__portrait" style="--ratio: 1 / 1">
                <Image src={img(t.portrait)} alt={`Portrait de ${t.name}`} widths={[320, 480, 640]} sizes="(min-width: 1024px) 420px, 100vw" format="webp" loading={i === 0 ? "eager" : "lazy"} />
              </div>
              <div class="testi__body">
                <p class="eyebrow testi__status">{t.status}</p>
                <p class="quote">{t.quote}</p>
                <div class="testi__meta">
                  <p class="testi__name">{t.name}</p>
                  <p class="testi__bio">{t.bio}</p>
                  <div class="testi__logo">{t.logo && <Logo name={t.logo.name} alt={t.logo.alt} height={t.logo.height} />}</div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div class="testi__controls">
        <div class="testi__arrows">
          <button type="button" class="testi__arrow" aria-label="Témoignage précédent" data-prev>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
          </button>
          <button type="button" class="testi__arrow" aria-label="Témoignage suivant" data-next>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
          </button>
        </div>
        <div role="tablist" aria-label="Choisir un témoignage" class="testi__dots">
          {
            TESTIMONIALS.map((t, i) => (
              <button type="button" role="tab" class="testi__dot" aria-label={`Témoignage de ${t.name}`} aria-selected={i === 0 ? "true" : "false"} aria-controls={`temoignage-${t.id}`} tabindex={i === 0 ? 0 : -1}></button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script src="@/scripts/carousel.ts"></script>

<style>
  .testi__head {
    margin-bottom: 72px;
  }
  .testi__title {
    max-width: 12em;
  }
  .testi__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(min(200px, 100%), 1fr) minmax(300px, 2.8fr);
    gap: 56px;
    align-items: stretch;
  }
  .testi__stats {
    display: flex;
    flex-direction: column;
  }
  .testi__stat {
    padding: 26px 0;
    border-top: 1px solid var(--line-strong);
  }
  .testi__stat-label {
    margin-top: 10px;
    font-size: 15px;
    color: var(--ink-62);
  }
  .testi__stat-end {
    border-top: 1px solid var(--line-strong);
    flex: 1;
  }
  .testi__slide {
    display: grid;
    grid-template-columns: minmax(min(260px, 100%), 1fr) minmax(300px, 1.15fr);
    gap: 56px;
  }
  .testi__slide[hidden] {
    display: none;
  }
  /*
   * Motion: the new testimonial glides in from 12 px on the side (direction = "next"), 300 ms
   * ease-out. A transition rather than keyframes so fast clicking on the arrows never restarts
   * from zero.
   */
  .testi__slide {
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  @starting-style {
    .testi__slide.is-entering {
      opacity: 0;
      transform: translateX(12px);
    }
  }
  .testi__body {
    display: flex;
    flex-direction: column;
  }
  .testi__status {
    margin-bottom: 18px;
  }
  .testi__meta {
    margin-top: auto;
    padding-top: 40px;
  }
  .testi__name {
    font-weight: 600;
    font-size: 17px;
  }
  .testi__bio {
    font-size: 15px;
    color: var(--ink-65);
  }
  .testi__logo {
    margin-top: 28px;
    min-height: 34px;
  }
  .testi__logo :global(img) {
    max-width: 140px;
    object-fit: contain;
  }
  .testi__logo {
    padding-bottom: 76px;
  }
  .testi__controls {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
  }
  .testi__arrows {
    display: flex;
    gap: 8px;
  }
  .testi__arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-ui);
    background: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 0.2s ease-out,
      transform 0.16s var(--ease-out);
  }
  .testi__arrow:hover {
    background: rgba(31, 13, 25, 0.05);
  }
  .testi__arrow:active {
    transform: scale(0.97);
  }
  .testi__dots {
    display: flex;
    gap: 6px;
  }
  .testi__dot {
    width: 12px;
    height: 4px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: rgba(31, 13, 25, 0.25);
    cursor: pointer;
    position: relative;
    transition:
      width 0.3s var(--ease-out),
      background-color 0.2s ease-out;
  }
  /* 44 px touch target without changing the visible 4 px bar */
  .testi__dot::after {
    content: "";
    position: absolute;
    inset: -20px -4px;
  }
  .testi__dot[aria-selected="true"] {
    width: 32px;
    background: var(--plum);
  }
  @media (max-width: 1199px) {
    .testi__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .testi__stats {
      flex-direction: row;
      gap: 24px;
    }
    .testi__stat {
      flex: 1;
    }
    .testi__stat-end {
      display: none;
    }
    .testi__controls {
      position: static;
      align-items: flex-start;
    }
    .testi__logo {
      padding-bottom: 0;
    }
  }
  @media (max-width: 767px) {
    .testi__head {
      margin-bottom: 40px;
    }
    .testi__slide {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .testi__stats {
      flex-direction: column;
      gap: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .testi__dot,
    .testi__arrow {
      transition: none;
    }
    .testi__slide {
      transition: opacity 0.3s ease;
    }
    @starting-style {
      .testi__slide.is-entering {
        transform: none;
      }
    }
  }
</style>
