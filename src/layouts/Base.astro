---
import "@fontsource/sora/200.css";
import "@fontsource/sora/300.css";
import "@fontsource/sora/400.css";
import "@fontsource/sora/600.css";
import "@fontsource/work-sans/400.css";
import "@fontsource/work-sans/500.css";
import "@fontsource/work-sans/600.css";
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Analytics from "@/components/Analytics.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { getImage } from "astro:assets";
import { img } from "@/data/images";
import { ORGANIZATION, SITE, WEBSITE } from "@/data/site";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  headerTone?: "plum" | "white";
  current?: string;
  crumbs?: { name: string; path?: string }[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  ogImage?: ImageMetadata;
}
const { title, description, headerTone = "white", current, crumbs, noindex = false, jsonLd = [], ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\.html$/, "").replace(/\/$/, "") || Astro.site!.href;
const breadcrumb = crumbs?.length
  ? {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Accueil", item: `${SITE.url}/` },
        ...crumbs.map((crumb, index) => ({
          "@type": "ListItem",
          position: index + 2,
          name: crumb.name,
          item: crumb.path ? new URL(crumb.path, SITE.url).href : canonical,
        })),
      ],
    }
  : undefined;
const graph = [ORGANIZATION, WEBSITE, ...(breadcrumb ? [breadcrumb] : []), ...jsonLd];
const ogResult = await getImage({
  src: ogImage ?? img("n_hero_pair"),
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
});
const og = new URL(ogResult.src, Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1f0d19" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <Analytics position="head" />
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />
  </head>
  <body>
    <Analytics position="body" />
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Header tone={headerTone} current={current} />
    <main id="main">
      {crumbs?.length && <Breadcrumbs items={crumbs} />}
      <slot />
    </main>
    <Footer />
    <script src="@/scripts/reveal.ts"></script>
    <script src="@/scripts/countup.ts"></script>
  </body>
</html>
