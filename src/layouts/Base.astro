---
import "@fontsource/sora/200.css";
import "@fontsource/sora/300.css";
import "@fontsource/sora/400.css";
import "@fontsource/sora/600.css";
import "@fontsource/work-sans/400.css";
import "@fontsource/work-sans/500.css";
import "@fontsource/work-sans/600.css";
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/data/site";

interface Props {
  title: string;
  description: string;
  headerTone?: "plum" | "white";
  current?: string;
  /** Extra JSON-LD objects for this page (the organisation is always included). */
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
}
const { title, description, headerTone = "white", current, jsonLd = [], ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, "") || Astro.site!.href;
const organisation = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: SITE.name,
  url: SITE.url,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.street,
    postalCode: SITE.address.postalCode,
    addressLocality: SITE.address.city,
    addressCountry: SITE.address.country,
  },
  sameAs: [
    "https://www.linkedin.com/school/eugenia-school/",
    "https://www.instagram.com/eugenia.school/",
    "https://www.youtube.com/@EugeniaSchool",
  ],
};
const og = ogImage ?? `${SITE.url}/og-default.jpg`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1f0d19" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...obj })} />)}
  </head>
  <body>
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Header tone={headerTone} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="@/scripts/reveal.ts"></script>
    <script src="@/scripts/countup.ts"></script>
  </body>
</html>
