---
import Base from "@/layouts/Base.astro";
import PageTop from "@/components/PageTop.astro";
import Pic from "@/components/Pic.astro";
import Logo from "@/components/Logo.astro";
import LogoMarquee from "@/components/LogoMarquee.astro";
import EndOfPage from "@/components/EndOfPage.astro";
import ContinueVisit from "@/components/ContinueVisit.astro";
import { img } from "@/data/images";
import { RECRUITERS } from "@/data/logos";
import { HACKATHONS, PARTNER_MARQUEE, WAYS } from "@/data/entreprises";
import { ROUTES } from "@/data/site";
import lot3 from "@/data/pages/lot3.json";

const ICONS: Record<string, string> = {
  recruit: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"/>',
  hackathon: '<path d="M4 20L20 4"/><path d="M14 4h6v6"/>',
  partner: '<path d="M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z"/><circle cx="12" cy="11" r="2.5"/>',
};
const PROJECT_LINKS = [
  { label: "Alle Projekte mit Unternehmen", href: ROUTES.projetsEntreprises, text: lot3["projets-entreprises"].page.description },
  { label: "Hackathon Mistral AI, Make und Malt", href: ROUTES.projetMistral, text: lot3["projets-entreprises/mistral-ai-hackathon"].page.description },
  { label: "Hackathon Mirakl × OpenAI", href: ROUTES.projetOpenAI, text: lot3["projets-entreprises/openai-hackathon"].page.description },
  { label: "Dust Customers Hackathon", href: ROUTES.projetDust, text: lot3["projets-entreprises/dust-hackathon"].page.description },
];
---

<Base
  title="Unternehmen: duale Ausbildung und Hackathons | Eugenia School"
  description="Rekrutieren Sie einen dual Studierenden, geben Sie unseren Studierenden ein Briefing für einen Hackathon oder werden Sie Partner der Schule. Tauschen Sie sich mit dem Team der Eugenia School aus."
  current={ROUTES.entreprises}
  crumbs={[{ name: "Unternehmen" }]}
>
  <PageTop
    title="Entreprises"
    lead="Rekrutieren Sie dual Studierende, die bereits mit KI bauen können. Oder geben Sie ihnen ein echtes Problem, für die Dauer eines Hackathons."
    image="p_award"
    alt="Ein Team von Studierenden feiert seinen Bronze Award beim Dust-Hackathon"
    position="45% 40%"
  />

  <section class="ways" aria-label="Drei Wege, mit der Schule zusammenzuarbeiten">
    <div class="container ways__grid">
      {
        WAYS.map((w) => (
          <div class="way">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[w.icon]} />
            <h2 class="h4 way__title">{w.title}</h2>
            <p class="way__text">{w.text}</p>
            <div class="way__link"><a href={w.link.href} class="lnk">{w.link.label}</a></div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container recruit" aria-labelledby="recruit-title">
    <h2 id="recruit-title" class="h2 recruit__title">Sie rekrutieren bereits unsere Studierenden.</h2>
    <ul class="logo-grid">
      {
        RECRUITERS.map((l) => (
          <li class="logo-grid__cell">
            <Logo name={l.name} alt={l.alt} height={Math.min(l.height, 34)} gray />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container oncampus" aria-labelledby="oncampus-title">
    <h2 id="oncampus-title" class="h2 oncampus__title">Auf dem Campus, das ganze Jahr.</h2>
    <div class="oncampus__grid">
      <figure>
        <Pic src={img("n_speaker")} alt="Start des PayFit-Hackathons vor den PayFit-Rollups im Atrium" ratio="16 / 9" sizes="(min-width: 1024px) 680px, 100vw" />
        <figcaption class="oncampus__caption"><div class="semibold">Der Start eines Hackathons</div><div class="muted text-15">Das PayFit-Briefing, den Studierenden im Atrium vorgestellt.</div></figcaption>
      </figure>
      <figure>
        <Pic src={img("n_partners")} alt="Bühnenpräsentation der Partner der Schule: Startups, Technologieanbieter und Konzerne" ratio="16 / 9" sizes="(min-width: 1024px) 680px, 100vw" />
        <figcaption class="oncampus__caption"><div class="semibold">Ein wachsendes Netzwerk</div><div class="muted text-15">Startups, Technologieanbieter und Konzerne, den Studierenden vorgestellt.</div></figcaption>
      </figure>
    </div>
  </section>

  <section id="hackathons" class="dark hack" aria-labelledby="hack-title">
    <div class="container">
      <div class="section-head hack__head">
        <h2 id="hack-title" class="h2 hack__title">Sie haben unseren Studierenden ein Briefing gegeben.</h2>
        <p class="hack__sub">48 Stunden, Teams von Studierenden, eine Demo vor der Jury des Unternehmens.</p>
      </div>
      <div class="hack__grid">
        {
          HACKATHONS.map((h) => (
            <article class="hack-card">
              <Pic src={img(h.image)} alt={h.alt} ratio="4 / 3" position={h.position} sizes="(min-width: 1024px) 440px, 100vw" widths={[480, 900, 1400]} class="hack-card__pic" />
              <div class="hack-card__shade"></div>
              <div class="hack-card__row">
                <h3 class="hack-card__title">{h.title}</h3>
                <Logo name={h.logo.name} alt={h.logo.alt} height={h.logo.height} class="logo-pad" />
              </div>
            </article>
          ))
        }
      </div>
      <nav class="hack__links" aria-labelledby="hack-title">
        {PROJECT_LINKS.map((link) => (
          <a class="hack__link-card" href={link.href}>
            <h3>{link.label}</h3>
            <p>{link.text}</p>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="partners" aria-labelledby="partners-title">
    <h2 id="partners-title" class="sr-only">Partner der Schule</h2>
    <LogoMarquee logos={PARTNER_MARQUEE} label="Partner der Schule" />
  </section>

  <div id="contact"></div>
  <EndOfPage
    title="Sprechen wir über Ihren nächsten dual Studierenden."
    primary={{ href: ROUTES.contact, label: "Nous contacter" }}
    secondary={{ href: ROUTES.brochure, label: "Unternehmensbroschüre herunterladen" }}
    image="p_team"
    position="50% 45%"
  />
  <ContinueVisit href={ROUTES.carrieres} title="Karrieren" text="Die Profile, die Sie rekrutieren können, und ihre Werdegänge." image="p_team" />
</Base>

<style>
  .ways {
    padding-block: 72px 0;
  }
  .ways__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-inline: 0;
  }
  .way {
    padding: 44px 32px 40px;
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }
  .way__title {
    margin-top: 28px;
  }
  .way__text {
    margin-top: 12px;
    font-size: 15px;
    color: var(--ink-68);
    line-height: 1.5;
  }
  .way__link {
    margin-top: 28px;
  }
  @media (min-width: 768px) {
    .ways__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .way {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding: 32px var(--gutter);
    }
    .way:first-child {
      border-top: 0;
    }
  }

  .recruit,
  .oncampus {
    padding-block: 140px 0;
  }
  .recruit__title,
  .oncampus__title {
    max-width: 10em;
  }
  .logo-grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .logo-grid__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 110px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .oncampus__grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 24px;
  }
  .oncampus__caption {
    margin-top: 16px;
  }

  .hack {
    margin-top: 140px;
    padding-block: 140px;
  }
  .hack__head {
    margin-bottom: 56px;
  }
  .hack__title {
    max-width: 10em;
  }
  .hack__sub {
    max-width: 24em;
    font-size: 17px;
    color: var(--paper-72);
  }
  .hack__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 20px;
  }
  .hack__links {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: 40px;
  }
  .hack__link-card {
    display: block;
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
  }
  .hack__link-card p {
    margin-top: 12px;
    color: var(--paper-72);
    font-size: 14px;
    line-height: 1.5;
  }
  .hack-card {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: #2a1622;
  }
  .hack-card :global(.pic) {
    border-radius: 0;
  }
  .hack-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(31, 13, 25, 0) 45%, rgba(31, 13, 25, 0.85));
  }
  .hack-card__row {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .hack-card__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
    letter-spacing: -0.02em;
  }

  .partners {
    padding: 130px 0 140px;
  }
  .partners__title {
    margin-bottom: 44px;
    text-align: center;
    font-weight: 400;
  }

  @media (min-width: 1024px) {
    .hack__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .hack__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .hack__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 1023px) {
    .hack__grid {
      grid-template-columns: 1fr;
    }
    .hack-card {
      max-width: 640px;
    }
  }
  @media (max-width: 767px) {
    .recruit,
    .oncampus {
      padding-top: var(--section-y);
    }
    .logo-grid {
      margin-top: 36px;
      grid-template-columns: repeat(2, 1fr);
    }
    .logo-grid__cell {
      min-height: 90px;
    }
    .oncampus__grid {
      margin-top: 36px;
      grid-template-columns: 1fr;
    }
    .hack {
      margin-top: var(--section-y);
      padding-block: var(--section-y);
    }
    .hack__grid {
      grid-template-columns: 1fr;
    }
    .partners {
      padding: var(--section-y) 0;
    }
  }
</style>
