---
import Base from "@/layouts/Base.astro";
import PageTop from "@/components/PageTop.astro";
import Pic from "@/components/Pic.astro";
import EndOfPage from "@/components/EndOfPage.astro";
import ShareLink from "@/components/ShareLink.astro";
import ContinueVisit from "@/components/ContinueVisit.astro";
import { img } from "@/data/images";
import { BACHELOR_YEARS, COMPARE_ROWS, MSC_CHIPS } from "@/data/programmes";
import { ORG_ID, ROUTES, SITE } from "@/data/site";

const courses = [
  {
    "@type": "EducationalOccupationalProgram",
    name: "Bachelor IA Applied to Business",
    description: "Trois ans, hors Parcoursup. Un socle commun en IA, data et no-code, puis une trajectoire et une troisième année en alternance.",
    provider: { "@id": ORG_ID },
    url: `${SITE.url}${ROUTES.programmeBachelor}`,
  },
  {
    "@type": "EducationalOccupationalProgram",
    name: "MSc IA Applied to Business",
    description: "Deux ans en alternance après un Bac+3 ou +4 : l'IA et l'automatisation appliquées en entreprise.",
    provider: { "@id": ORG_ID },
    url: `${SITE.url}${ROUTES.programmeMsc}`,
  },
];
---

<Base
  title="Bachelor und MSc für KI in Paris | Eugenia School"
  description="Bachelor en trois ans après le bac, MSc en deux ans en alternance, et deux certifications professionnelles. Un même socle en IA, data et no-code."
  current={ROUTES.programmes}
  crumbs={[{ name: "Studienprogramme" }]}
  jsonLd={courses}
>
  <PageTop
    title="Studienprogramme"
    lead="Zwei Einstiege, dieselben Grundlagen in KI, Daten und No-Code. Dazu Zertifizierungen für gezielte Kompetenzen."
    image="n_crowd"
    alt="Rund hundert Studierende hören auf den Sitzstufen im Atrium zwei Vortragenden zu"
  />

  <section class="container compare" aria-labelledby="compare-title">
    <h2 id="compare-title" class="h2-sm compare__title">Bachelor oder Master?</h2>
    <div class="compare__table" role="table">
      <div class="compare__row compare__row--head" role="row">
        <div role="columnheader"><span class="sr-only">Kriterium</span></div>
        <div role="columnheader">Bachelor</div>
        <div role="columnheader">MSc</div>
      </div>
      {
        COMPARE_ROWS.map((r) => (
          <div class="compare__row" role="row">
            <div class="compare__label" role="rowheader">{r.label}</div>
            <div role="cell">{r.bachelor}</div>
            <div role="cell">{r.msc}</div>
          </div>
        ))
      }
      <div class="compare__end"></div>
    </div>
  </section>

  <section id="bachelor" class="mist prog" aria-labelledby="bachelor-title">
    <div class="container prog__grid">
      <div>
        <p class="eyebrow prog__eyebrow">3 Jahre nach dem Abitur</p>
        <h2 id="bachelor-title" class="h2 prog__title">Bachelor Angewandte KI für Unternehmen</h2>
        <p class="prog__text">Gemeinsame Grundlagen in KI, Daten und No-Code, danach wählst du deinen Schwerpunkt. Ein erstes KI-Projekt im Unternehmen schon im ersten Semester und ein drittes Studienjahr im dualen Studium.</p>
        <div class="btn-row">
          <a href={ROUTES.candidature} class="btn">Für den Bachelorstudiengang bewerben</a>
          <a href={ROUTES.programmeBachelor} class="btn-outline">Studiengang kennenlernen</a>
        </div>
        <p class="lnk-row"><a class="lnk" href={ROUTES.programmeBachelor3}>Das 3. Jahr im dualen Studium ansehen</a> · <a class="lnk" href={ROUTES.brochure}>Informationsbroschüre herunterladen</a></p>
      </div>
      <div>
        <Pic src={img("p_duo")} alt="Zwei Studierende sitzen lächelnd auf den Sitzstufen des Campus" ratio="16 / 9" sizes="(min-width: 1024px) 640px, 100vw" class="prog__pic" />
        <ol class="years">
          {
            BACHELOR_YEARS.map((y) => (
              <li class="years__row">
                <span class="years__year">{y.year}</span>
                <div>
                  <div class="years__title">{y.title}</div>
                  <div class="years__text">{y.text}</div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section id="msc" class="dark prog" aria-labelledby="msc-title">
    <div class="container prog__grid prog__grid--center">
      <Pic src={img("p_sweater")} alt="Ein Student zeigt stolz das Logo der Eugenia School auf seinem Pullover" ratio="4 / 5" sizes="(min-width: 1024px) 640px, 100vw" />
      <div>
        <p class="eyebrow prog__eyebrow">2 Jahre nach drei oder vier Studienjahren</p>
        <h2 id="msc-title" class="h2 prog__title">MSc Angewandte KI für Unternehmen</h2>
        <p class="prog__text prog__text--tight">Von der Theorie zur Praxis: KI und Automatisierung im Unternehmen, im dualen Studium.</p>
        <div class="chips prog__chips">{MSC_CHIPS.map((c) => <span class="chip">{c}</span>)}</div>
        <div class="btn-row">
          <a href={ROUTES.candidature} class="btn">Für den Masterstudiengang bewerben</a>
          <a href={ROUTES.programmeMsc} class="btn-outline">Studiengang kennenlernen</a>
        </div>
        <p class="lnk-row"><a class="lnk" href={ROUTES.brochure}>Informationsbroschüre herunterladen</a></p>
      </div>
    </div>
  </section>

  <section id="certifications" class="container certs" aria-labelledby="certs-title">
    <h2 id="certs-title" class="h2-sm certs__title">Berufliche Zertifizierungen</h2>
    <div class="certs__grid">
      <article class="cert">
        <h3 class="h3-sm">Entwickler für No-Code-Lösungen</h3>
        <p class="cert__text">Geschäftsanwendungen entwickeln und bereitstellen, ohne Code zu schreiben.</p>
        <div class="cert__link"><a href={ROUTES.certificationNoCode} class="lnk">Zertifizierung ansehen</a></div>
      </article>
      <article class="cert">
        <h3 class="h3-sm">KI-Architekt</h3>
        <p class="cert__text">Nützliche und zuverlässige KI-Systeme für Unternehmen entwickeln.</p>
        <div class="cert__link"><a href={ROUTES.certificationArchitecteIA} class="lnk">Zertifizierung ansehen</a></div>
      </article>
    </div>
  </section>

  <EndOfPage
    title="Bereit, etwas zu entwickeln?"
    primary={{ href: ROUTES.admissions, label: "Jetzt bewerben" }}
    secondary={{ href: ROUTES.contact, label: "Eine Frage stellen" }}
    image="p_payfit"
    position="50% 45%"
  />
  <div class="container share-row">
    <ShareLink path={ROUTES.parents} label="Mit meinen Eltern teilen" title="Eugenia School: Informationen für meine Eltern" text="Ich interessiere mich für diese Hochschule im nächsten Jahr. Hier findest du alles Wissenswerte für Eltern:" event="share_to_parent" />
  </div>
  <ContinueVisit href={ROUTES.carrieres} title="Karriere" text="Wohin diese Studiengänge führen: vom dualen Studium zur ersten unbefristeten Stelle." image="p_team" />
</Base>

<style>
  .share-row {
    padding-block: 32px 8px;
  }
  .compare {
    padding-block: 130px;
  }
  .compare__title {
    max-width: 12em;
  }
  .compare__table {
    margin-top: 56px;
  }
  .compare__row {
    display: grid;
    grid-template-columns: 220px 1fr 1fr;
    gap: 32px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
    font-size: 16px;
  }
  .compare__row--head {
    border-top: 0;
    padding: 0 0 18px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
  }
  .compare__label {
    color: var(--ink-60);
  }
  .compare__end {
    border-top: 1px solid var(--line);
  }
  @media (max-width: 767px) {
    .compare {
      padding-block: var(--section-y);
    }
    .compare__row {
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
    }
    .compare__label {
      grid-column: 1 / -1;
      font-size: 14px;
    }
    .compare__row--head > :first-child {
      display: none;
    }
  }

  .prog {
    padding-block: 140px;
  }
  .prog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 72px;
    align-items: start;
  }
  .prog__grid--center {
    align-items: center;
  }
  .prog__eyebrow {
    margin-bottom: 18px;
  }
  .prog__title {
    max-width: 10em;
  }
  .prog__text {
    margin: 28px 0 40px;
    color: var(--ink-72);
    max-width: 30em;
  }
  .dark .prog__text {
    color: var(--paper-76);
  }
  .prog__text--tight {
    margin-bottom: 32px;
  }
  .prog__chips {
    margin-bottom: 44px;
  }
  .prog__pic {
    margin-bottom: 32px;
  }
  .years__row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 24px;
    padding: 30px 0;
    border-top: 1px solid var(--line-strong);
  }
  .years__year {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 22px;
  }
  .years__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    margin-bottom: 6px;
  }
  .years__text {
    font-size: 16px;
    color: var(--ink-70);
  }
  @media (max-width: 767px) {
    .prog {
      padding-block: var(--section-y);
    }
    .prog__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .certs {
    padding: 140px var(--gutter) 150px;
  }
  .certs__title {
    max-width: 14em;
  }
  .certs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 20px;
    margin-top: 56px;
  }
  .cert {
    border: 1px solid rgba(31, 13, 25, 0.1);
    border-radius: var(--radius);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 240px;
  }
  .cert__text {
    color: var(--ink-70);
    font-size: 16px;
  }
  .cert__link {
    margin-top: auto;
  }
  @media (max-width: 767px) {
    .certs {
      padding-block: var(--section-y);
    }
    .certs__grid {
      grid-template-columns: 1fr;
    }
    .cert {
      padding: 28px;
      min-height: 0;
    }
  }
</style>
